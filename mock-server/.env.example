# 複製成 .env 後填入；.env 不會進版控。
# 沒設任何 slot 時使用範例專案 _example（EXAMPLE_TARGET_URL 可選）。
EXAMPLE_TARGET_URL=

# 真實專案：每個 slot（A、B、C…）一組，<SLOT>_PROJECT_ID 有值才啟用。
# 專案 id = src/mocks/<id>/ 資料夾名（該資料夾被 .gitignore 排除，只存在你的機器）。
# A_PROJECT_ID=
# A_TARGET_URL=
# A_PORT=3200
# A_WS_PORT=8080
# A_PROXY_PORT=3201
# B_PROJECT_ID=
# B_TARGET_URL=

# RECORD_RESPONSES=false
